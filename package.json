{
  "name": "my-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently npm:dev:*",
    "dev:server": "ts-node ./src/index.ts",
    "dev:worker": "ts-node ./src/index-worker.ts",
    "build": "tsc",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "migration:generate": "ts-node migration generate",
    "migration:run": "ts-node migration run",
    "migration:revert": "ts-node migration revert",
    "debug:cognito": "node debug-cognito.js",
    "test:cognito-connection": "node test-cognito-connection.js"
  },
  "dependencies": {
    "@vendure/admin-ui-plugin": "3.4.0",
    "@vendure/asset-server-plugin": "3.4.0",
    "@vendure/core": "3.4.0",
    "@vendure/email-plugin": "3.4.0",
    "@vendure/graphiql-plugin": "3.4.0",
    "dotenv": "16.3.1",
    "express": "5.1.0",
    "pg": "8.11.3",
    "typescript": "5.3.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "passport-oauth2": "^1.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/passport-oauth2": "^1.4.15",
    "concurrently": "8.2.2",
    "ts-node": "10.9.2",
    "@vendure/cli": "3.4.0"
  }
}
